{
    "name": "mesh2motion-app",
    "compatibility_date": "2025-08-24",
    "assets": {
      "directory": "./dist"
    },
    "main": "src/survey-worker.js",
    "durable_objects": {
      "bindings": [{ "name": "BRIDGE", "class_name": "BridgeSession" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BridgeSession"] }],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "m2m-survey-responses",
        "database_id": "5805df06-efd6-4e30-93f3-40e6e0efd523"
      }
    ]
}